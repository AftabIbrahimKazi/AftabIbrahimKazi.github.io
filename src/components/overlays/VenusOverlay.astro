// src/components/overlays/VenusOverlay.astro
// 9 sections — layout data-attributes drive CSS positioning.
// Sections match VENUS_SCROLL_PATH waypoints in PlanetScrollCameras.ts.

const projects = [
  {
    id:       'portfolio-solar-system',
    meta:     'Astro + Three.js · 2026',
    category: 'PORTFOLIO',
    title:    'This Site: An Explorable Three.js Solar System',
    excerpt:  'The portfolio itself — an Astro 6 MPA where every planet material compiles from a Triforge node graph and every utility class ships from Strata CSS.',
    date:     '2026',
    image:    null,
    demoUrl:  'https://github.com/AftabIbrahimKazi/AftabIbrahimKazi.github.io',
    body: [
      'Nine planets, one warp-speed page router, and zero hand-written GLSL — every surface here is built on the two packages below, in production, under real deadline pressure.',
    ],
    topics: ['The Build'],
  },
  {
    id:       'triforge-node-system',
    meta:     'npm · @triforge/* · Stage 1 complete',
    category: 'LIBRARY',
    title:    'Triforge: Blender-Style Node Workflows for Three.js',
    subtitle: 'Blender-Style Node Workflows for Three.js',
    excerpt:  'A 19-package suite that brings Blender\'s node-graph workflow — geometry, shading, particles, physics, animation — to plain Three.js, with no dependency beyond Three.js itself.',
    date:     '2026',
    image:    null,
    demoUrl:  'https://github.com/AftabIbrahimKazi/triforge',
    stats: [
      { value: 19,  suffix: '',  label: 'Packages' },
      { value: 100, suffix: '+', label: 'Runnable Examples' },
      { value: 75,  suffix: '',  label: 'Shader Nodes' },
    ],
    body: [
      'Triforge covers the same ground Blender\'s node editor does — procedural geometry (`geometry-nodes`, `modifier-core`, `curve-core`), shading and rendering (`shader-core`\'s 75 nodes, `compositor-core`, `pathtracer-core`, `volume-core`), simulation (`particle-core`, `physics-core`, `fluid-core`, `hair-core`), and animation (`animation-core`, `keyframe`) — compiled down to standard Three.js `BufferGeometry`, `Material`, and `Texture` objects.',
      'Each package installs on its own with a plain `npm install`, keeps Three.js as its only hard dependency, and ships with over 100 runnable HTML examples and TypeScript types instead of a required build step. It works with vanilla Three.js and React Three Fiber on any r128+ project.',
      'Stage 1 — all 19 packages — is complete and MIT-licensed. Stage 2, a GUI node-editor application and a terrain/vegetation addon suite, is next on the roadmap.',
    ],
    topics: ['The Node Suite', 'No Build Step', 'What\'s Next'],
  },
  {
    id:       'strata-css-framework',
    meta:     'npm · strata-css',
    category: 'LIBRARY',
    title:    'Strata: A JIT CSS Framework',
    subtitle: 'A JIT CSS Framework',
    excerpt:  'A PostCSS plugin that pairs Bootstrap-style ready-made components with Tailwind-style just-in-time class generation — only the CSS a project actually uses ships.',
    date:     '2026',
    image:    null,
    demoUrl:  'https://github.com/AftabIbrahimKazi/strata',
    stats: [
      { value: 6, suffix: '', label: 'Companion Packages' },
      { value: 6, suffix: '', label: 'Variant Prefixes' },
      { value: 3, suffix: '', label: 'Built-in Themes' },
    ],
    body: [
      'Components like `btn-primary`, `card`, and `navbar` work with no configuration, while arbitrary values (`mt-[24px]`, `bg-[#ff0000]`) and state variants (`hover:`, `focus-visible:`, `group-hover:`, `peer-checked:`, `before:`, `print:`) cover everything a fixed utility scale misses.',
      'Framework styles sit inside CSS cascade layers, so no rule ever needs `!important`, and custom unlayered CSS automatically overrides Strata. Components are controlled through `data-st-*` attributes rather than JS class toggling.',
      'Six optional companion packages — `modal`, `offcanvas`, `picker`, `forms`, `chart`, and `shopmap` — extend the framework for consumers who want the component behaviour without the full utility layer, and vice versa.',
    ],
    topics: ['Components + JIT', 'Layers Over !important', 'The Companion Packages'],
  },
  {
    id:       'fish-pond-experiments',
    meta:     'Next.js · Three.js · Triforge',
    category: 'EXPERIMENT',
    title:    'Fish Pond: 3D Fish-Behavior Experiments',
    subtitle: '3D Fish-Behavior Experiments',
    excerpt:  'Browser-based experiments comparing reflex-like, probabilistic, and deliberative decision-making in a simulated fish — no backend, no account, no tracking.',
    date:     '2026',
    image:    null,
    demoUrl:  'https://github.com/AftabIbrahimKazi/fish-pond',
    stats: [
      { value: 8,  suffix: '',  label: 'Stimuli Tested' },
      { value: 62, suffix: '',  label: 'Scene Settings' },
      { value: 16, suffix: 's', label: 'Auto Test Cycle' },
    ],
    body: [
      'The Cognitive Arena runs a scripted, non-AI fish against eight stimuli — known ones trigger fast reflexes, unknown ones get a slower, multi-phase appraisal, with short-term memory visible in a live "Fish Mind" readout. The Visual Telemetry Benchmark runs three scripted controllers side by side on identical, seeded inputs over a 16-second automated cycle.',
      'The Underwater scene is the realistic one: caustics, water absorption, and bloom, with 62 adjustable settings exportable as JSON. Its materials are built as Triforge node graphs rather than hand-written GLSL, matching the same approach used on this site\'s planets.',
      'Fish decisions in that scene are made by an on-device, opt-in ONNX model — "Laya-AI," roughly a 524MB download — while the renderer only carries out what the model decides. System 2 reasoning for the underwater fish is on the roadmap, not yet implemented.',
    ],
    topics: ['Cognitive Arena', 'Visual Telemetry', 'Laya-AI'],
  },
  {
    id:       'inkwake-css-benchmark',
    meta:     'TypeScript · Lighthouse',
    category: 'BENCHMARK',
    title:    'Inkwake: A CSS Framework Benchmark',
    subtitle: 'A CSS Framework Benchmark',
    excerpt:  'The same anime-themed e-commerce landing page, built three times — once each in Tailwind, Bootstrap 5, and Strata — then Lighthouse-benchmarked to isolate what the framework itself costs.',
    date:     '2026',
    image:    null,
    demoUrl:  'https://github.com/AftabIbrahimKazi/inkwake',
    stats: [
      { value: 3,  suffix: '', label: 'Frameworks Compared' },
      { value: 19, suffix: '', label: 'Page Sections' },
      { value: 10, suffix: '', label: 'Isolated Runs Each' },
    ],
    body: [
      'Markup intent, copy, business logic, and self-hosted assets stay identical across all three builds — a mega menu, master footer, 19 content sections, and a three-theme toggle. Only the CSS framework and its native JS idiom changes between them.',
      'Each build is deployed live and measured with Lighthouse under mobile and desktop presets, ten isolated runs per app per mode against the live deployments rather than local dev servers, reporting medians alongside means to filter out CPU-contention noise from parallel runs.',
      'Bootstrap ships raw and unpurged; Strata\'s build is minified with Lightning CSS — the goal is an apples-to-apples read on what payload and Core Web Vitals cost comes from the framework itself, not from the page it is building.',
    ],
    topics: ['The Setup', 'The Methodology', 'What\'s Held Constant'],
  },
  {
    id:       'ai-dev-kit-skills',
    meta:     'Markdown · MIT',
    category: 'TOOLKIT',
    title:    'AI Dev Kit: Skills and Coding Standards for AI Agents',
    subtitle: 'Skills and Coding Standards for AI Agents',
    excerpt:  'Agent skills, optional MCP servers, and a layered coding-standards system that helps Claude Code, OpenCode, and similar agents work consistently across projects.',
    date:     '2026',
    image:    null,
    demoUrl:  'https://github.com/AftabIbrahimKazi/ai-dev-kit',
    stats: [
      { value: 47, suffix: '', label: 'Audit Rules Checked' },
    ],
    body: [
      'Each skill is a single `SKILL.md` file that only loads when its trigger matches the task at hand, covering model-specific behaviour, workflow discipline, memory, and specific technologies — no agent carries context it isn\'t using.',
      'The coding-standards layer sets testable rules for CSS, HTML, JS/TS, git, SEO, accessibility, and performance, with framework-specific overrides for Astro, Bootstrap, and Strata. Where the standards are silent on something, the agent is told to flag the gap rather than invent a rule.',
      'A project-wide code-audit skill checks 47 script-checkable rules, groups violations, and keeps a baseline so the violation count can only go down over time — the same discipline this portfolio\'s own build is checked against.',
    ],
    topics: ['Skills That Load on Trigger', 'Layered Standards', 'The Audit Baseline'],
  },
];
