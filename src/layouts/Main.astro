---
// src/layouts/Main.astro
// Legacy pre-LandingHeader/LandingFooter components — no longer used on this
// layout (was bleeding through uncontrolled on mobile viewports). Left
// commented out, not deleted, in case they're reused elsewhere later.
// import Header from "../components/Header.astro";
// import Footer from "../components/Footer.astro";
import Scene from "../components/Scene.astro";
import ContentOverlay from "../components/overlays/ContentOverlay.astro";
import WarpOverlay from "../components/WarpOverlay.astro";
import { Icon } from "astro-icon/components";
import "../styles/strata.css";
import "@fortawesome/fontawesome-free/css/all.min.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  isDark?: boolean;
}

const {
  title       = "Exo Space Planetarium",
  description = "Explore our solar system in an interactive 3D planetarium built with Astro and Three.js.",
  canonical   = Astro.url.href,
  ogImage     = "/images/footer.png",
  isDark      = true,
} = Astro.props;
const themeValue = isDark ? "dark" : "light";
---

<!doctype html>
<html lang="en" id="ex-html-theme-js" data-ex-theme={themeValue} data-st-theme={themeValue}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- custom-font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- custom-css -->
    <link rel="stylesheet" href="/css/variables.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/responsive.css" />


    <link rel="stylesheet" href="/css/overlay/explore-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/mercury-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/venus-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/earth-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/mars-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/jupiter-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/saturn-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/uranus-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/neptune-overlay.css" />
    <link rel="stylesheet" href="/css/overlay/sun-overlay.css" />

    <!-- custom-ts -->
    <script>
      import '../scripts/sol-entry';
    </script>
    <script>
      import '../scripts/warp-entry';
    </script>
    <script>
      import '../scripts/ui/shared/ThemeToggle';
    </script>
    <script>
      import '../scripts/ui/shared/MusicToggle';
    </script>
  </head>
  <body class="ex-body" data-cursor-state="default" data-scroll-state="auto">
    <WarpOverlay />
    <div id="ex-top-sensor-js"></div>
    <Scene />
    <ContentOverlay />

    <!-- Three.js Resources badge — same button as the landing footer/header, mirrored to
         the right side of the scene. Theme-aware (this layout has the light/dark toggle,
         unlike landing): bg/border/text follow --ex-badge-bg/--ex-border-color/--ex-text-body,
         logo invert is applied only in dark theme (main.css, data-ex-theme selector).
         Exact-brand gap/radius/shadow values still have no matching project token —
         hardcoded on purpose per css-standards RULE 20. -->
    <a
      href="https://threejsresources.com/showcase/aftabibrahimkazi-github-io?ref=badge"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Featured on Three.js Resources"
      class="ex-threejs-badge-scene d-inline-flex align-items-center position-fixed bottom-[var(--ex-space-md)] right-[var(--ex-space-md)] z-[var(--ex-z-badge)] gap-[10px] rounded-[8px] bg-[var(--ex-badge-bg)] border-[1px_solid_var(--ex-border-color)] shadow-[0_1px_2px_rgba(0,0,0,0.05)] text-decoration-none py-[6px] ps-[var(--ex-space-sm)] pe-[var(--ex-space-sm)]"
    >
      <img
        src="https://threejsresources.com/logo.svg"
        alt="Three.js Resources Logo"
        width="20"
        height="20"
        loading="lazy"
        class="ex-threejs-badge-scene-logo d-block object-fit-contain h-[var(--ex-size-20)] w-[var(--ex-size-20)]"
      />
      <span class="d-flex flex-column">
        <span class="fs-[var(--ex-font-size-xxxs)] fw-[var(--ex-para-font-weight)] text-[var(--ex-text-body)]">Featured on</span>
        <span class="fs-[var(--ex-font-size-xs)] fw-[var(--ex-font-weight-semibold)] text-[var(--ex-text-body)]">Three.js Resources</span>
      </span>
    </a>
    <!-- Legacy header — see commented-out import above. Kept for future reuse. -->
    <!-- <Header /> -->

    <main>
      <slot />
    </main>

    <div class="ex-toggle-container">
      <button
        id="ex-scroll-top-btn-js"
        data-scroll-top-state="no"
        data-visibility-state="hidden"
      >
        <div class="ex-icon-wrapper">
          <Icon name="lucide:chevron-up" class="ex-icon" />
        </div>
      </button>

      <!-- Theme toggle disabled for now — site stays light-mode only.
      <button id="ex-toggle-theme-js" data-ex-theme="dark">
          <div class="ex-icon-wrapper">
            <Icon name="lucide:sun" class="ex-icon" />
          </div>
          <div class="ex-icon-wrapper">
            <Icon name="lucide:moon" class="ex-icon" />
          </div>
      </button>
      -->

      <button id="ex-toggle-music-btn-js" data-sound-state="paused">
        <div class="ex-icon-wrapper">
          <svg viewBox="0 0 40 20" preserveAspectRatio="none" class="ex-icon">
            <path class="ex-wave-path" d="M0,10 L40,10"></path>
          </svg>
        </div>
        <audio id="ex-bgm-link-js" loop>
          <source src="/audio/space-themed-bgm.mp3" type="audio/mpeg" />
          Your browser does not support the audio element.
        </audio>
      </button>
    </div>

    <!-- Legacy footer — see commented-out import above. Kept for future reuse. -->
    <!-- <Footer /> -->
  </body>
</html>
